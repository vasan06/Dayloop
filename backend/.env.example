# NEXORA Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit a real .env file. Secrets must stay out of source control.

# ----- Database -----
# Async PostgreSQL DSN for the application
DATABASE_URL=postgresql+psycopg://dayloop_user:123456@localhost:5432/dayloop

# Async PostgreSQL DSN for the NEXORA test database (separate DB, never production)
TEST_DATABASE_URL=postgresql+psycopg://dayloop_user:123456@localhost:5432/dayloop_test

# ----- JWT Secrets -----
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
ACCESS_TOKEN_SECRET=08e8c264c13a45caf87458f51ee274b2078d69d756b9ebbe56267cf6625eb7a30e6dce038fa7b4845a7cd346053c2d9e0b4700ec515a58f410c9dd6c1d298341
REFRESH_TOKEN_SECRET=1d865099bfa658b5db503af01ee10bc230ab9fb688ece31692661704595a7b1dd3db653926a2abb2b4bed576ec6dc479eefb1010351fdc0cd00411cef9aef206

# Access token lifetime in minutes (short-lived)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token lifetime in days (rotating)
REFRESH_TOKEN_EXPIRE_DAYS=30

# ----- App Settings -----
APP_ENV=development
# Set to a comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ----- Email / SMTP (for verification and password reset) -----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=CHANGE_ME
EMAIL_FROM=no-reply@example.com

# ----- Firebase (Google Sign-In only) -----
# Path to the Firebase service account JSON file (outside source tree)
FIREBASE_CREDENTIALS_PATH=/path/to/firebase-service-account.json
# Firebase project ID
FIREBASE_PROJECT_ID=dayloop-a5c00
# ----- Security -----
# Rate limiting: max requests per minute per IP
RATE_LIMIT_PER_MINUTE=60
