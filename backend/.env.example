# NEXORA Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit a real .env file. Secrets must stay out of source control.

# ----- Database -----
# Async PostgreSQL DSN for the application
DATABASE_URL=postgresql+psycopg://nexora_user:CHANGE_ME@localhost:5432/nexora

# Async PostgreSQL DSN for the NEXORA test database (separate DB, never production)
TEST_DATABASE_URL=postgresql+psycopg://nexora_user:CHANGE_ME@localhost:5432/nexora_test

# ----- JWT Secrets -----
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
ACCESS_TOKEN_SECRET=CHANGE_ME_64_hex_chars
REFRESH_TOKEN_SECRET=CHANGE_ME_64_hex_chars_different

# Access token lifetime in minutes (short-lived)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token lifetime in days (rotating)
REFRESH_TOKEN_EXPIRE_DAYS=30

# ----- App Settings -----
APP_ENV=development
# Set to a comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ----- Email / SMTP (for verification and password reset) -----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=CHANGE_ME
EMAIL_FROM=no-reply@example.com

# ----- Firebase (Google Sign-In only) -----
# Path to the Firebase service account JSON file (outside source tree)
FIREBASE_CREDENTIALS_PATH=/path/to/firebase-service-account.json
# Firebase project ID
FIREBASE_PROJECT_ID=your-firebase-project-id

# ----- Security -----
# Rate limiting: max requests per minute per IP
RATE_LIMIT_PER_MINUTE=60
